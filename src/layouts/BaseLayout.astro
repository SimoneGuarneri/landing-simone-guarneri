---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource/geist/300.css';
import '@fontsource/geist/400.css';
import '@fontsource/geist/500.css';
import '@fontsource/geist/600.css';
import '@fontsource/geist-mono/400.css';
import '../styles/global.css';
import { defaultLocale, locales, localizedPath, t, type Locale } from '../lib/i18n';
// Importing the content entry validates every src/content/*.json at build time.
import '../lib/content/astro';
import SeoHead from '../components/SeoHead.astro';
import Analytics from '../components/Analytics.astro';
import { THEME_STORAGE_KEY } from '../lib/theme';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  /** Locale-neutral page path (`/`, `/privacy/`), used for hreflang alternates. */
  path?: string;
}

const { lang, title, description, path = '/' } = Astro.props;

const absolute = (l: Locale) => new URL(localizedPath(l, path), Astro.site).href;
const alternates = locales.map((l) => ({ hreflang: l, href: absolute(l) }));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}favicon.svg`} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(defaultLocale)} />
    <!-- Theme before first paint: stored choice wins, else OS preference. -->
    <script is:inline define:vars={{ themeKey: THEME_STORAGE_KEY }}>
      (function () {
        var theme = null;
        try {
          var stored = localStorage.getItem(themeKey);
          if (stored === 'light' || stored === 'dark') theme = stored;
        } catch (_) {
          // Storage blocked (private mode): fall back to the OS preference below.
        }
        if (!theme) {
          theme =
            window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <SeoHead lang={lang} title={title} description={description} path={path} />
    <Analytics />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'skipLink')}</a>
    <slot />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--yellow);
    color: var(--black);
    font-weight: 500;
    text-decoration: none;
    transform: translateY(-150%);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
