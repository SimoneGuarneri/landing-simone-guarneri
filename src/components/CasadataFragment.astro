---
/**
 * A cropped fragment of Casadata's demo report, built in HTML: the yearly figure and the
 * seasonality bars, with a switch between the two public demo reports (Salerno, Milan).
 * Figures: src/lib/casadata.ts. Both cities share one scale, so Milan's bars stand taller.
 * Bars rise one after another when it scrolls into view (motion/reveal.ts, data-reveal="bars")
 * and move to the other city's values on a switch. Without the script it is the Salerno
 * report with no switch.
 */
import { CITIES, yearly } from '../lib/casadata';
import { contacts } from '../lib/content/astro';
import { t, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale, 'casadataFragment');
const origin = new URL(contacts.casadataDemoUrl).origin;
const max = Math.max(...CITIES.flatMap((c) => c.months));
const fmtK = (n: number) => `€${(n / 1000).toLocaleString(locale, { maximumFractionDigits: 1 })}k`;
const monthName = (i: number) => new Intl.DateTimeFormat(locale, { month: 'long', timeZone: 'UTC' }).format(Date.UTC(2026, i, 1));
/** Everything the switch swaps in, per city, precomputed for the script. */
const views = CITIES.map((c) => ({
  id: c.id,
  name: copy.cities[c.id].name,
  place: copy.cities[c.id].place,
  finding: copy.cities[c.id].finding,
  total: `€${yearly(c).toLocaleString(locale)}`,
  href: origin + c.path,
  bars: c.months.map((v, i) => ({ v: +(v / max).toFixed(3), label: fmtK(v), peak: c.peak.includes(i), said: `${monthName(i)}: ${fmtK(v)}` })),
}));
const first = views[0];
---

<figure class="fragment" data-ui data-casadata={JSON.stringify(views)}>
  <div class="top">
    <div>
      <p class="place" data-cd="place">{first.place}</p>
      <p class="figure" data-cd="total">{first.total}</p>
      <p class="figure-note">{copy.yearly}</p>
    </div>
    <div class="side">
      <div class="switch" role="group" aria-label={copy.switchLabel} hidden>
        {
          views.map((v, i) => (
            <button type="button" data-city={v.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              {v.name}
            </button>
          ))
        }
      </div>
      <p class="finding" data-cd="finding" aria-live="polite">{first.finding}</p>
    </div>
  </div>
  <ol data-reveal="bars" class="bars" aria-label={copy.chartLabel}>
    {
      first.bars.map((b) => (
        <li class:list={['month', { peak: b.peak }]}>
          <span class="visually-hidden" data-cd="said">
            {b.said}
          </span>
          <span class="col" aria-hidden="true">
            <span class="bar" data-bar style={`--v: ${b.v}`} />
          </span>
          <span class="label" aria-hidden="true">
            <span class="value" data-cd="value">
              {b.label}
            </span>
            {b.said.charAt(0).toUpperCase()}
          </span>
        </li>
      ))
    }
  </ol>
  <figcaption>
    <a href={first.href} target="_blank" rel="noopener" class="open" data-cd="open"
      >{copy.open} <span aria-hidden="true">↗</span></a
    >
  </figcaption>
</figure>

<script>
  interface View {
    id: string;
    place: string;
    finding: string;
    total: string;
    href: string;
    bars: { v: number; label: string; peak: boolean; said: string }[];
  }

  document.querySelectorAll<HTMLElement>('[data-casadata]').forEach((root) => {
    const views: View[] = JSON.parse(root.dataset.casadata ?? '[]');
    const one = (key: string) => root.querySelector<HTMLElement>(`[data-cd="${key}"]`)!;
    const all = (key: string) => Array.from(root.querySelectorAll<HTMLElement>(`[data-cd="${key}"]`));
    const months = Array.from(root.querySelectorAll<HTMLElement>('.month'));
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-city]'));
    const show = (view: View) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.city === view.id)));
      one('place').textContent = view.place;
      one('total').textContent = view.total;
      one('finding').textContent = view.finding;
      one('open').setAttribute('href', view.href);
      const said = all('said');
      const values = all('value');
      view.bars.forEach((b, i) => {
        months[i].classList.toggle('peak', b.peak);
        months[i].querySelector<HTMLElement>('[data-bar]')!.style.setProperty('--v', String(b.v));
        said[i].textContent = b.said;
        values[i].textContent = b.label;
      });
    };
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const view = views.find((v) => v.id === b.dataset.city);
        if (view) show(view);
      }),
    );
    root.querySelector<HTMLElement>('.switch')!.hidden = false;
  });
</script>

<style>
  /* The product's own look: Casadata's light panel, grey bars, purple for the months that matter. */
  [data-ui].fragment {
    margin: 0;
    background: #f4f4f2;
    color: #141414;
    border-radius: 20px;
    padding: clamp(20px, 2.6vw, 32px);
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.4vw, 28px);
  }

  [data-ui] .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px 32px;
  }

  [data-ui] p {
    margin: 0;
  }

  [data-ui] .place,
  [data-ui] .figure-note {
    font-size: 14px;
    color: #5b5b5b;
  }

  [data-ui] .figure {
    margin-top: 6px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(36px, 3.6vw, 52px);
    line-height: 1;
    letter-spacing: -.04em;
    font-variant-numeric: tabular-nums;
  }

  [data-ui] .figure-note {
    margin-top: 6px;
  }

  [data-ui] .side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  /* Casadata's own city switch: a grey track, the chosen city in ink. */
  [data-ui] .switch {
    display: inline-flex;
    padding: 4px;
    gap: 2px;
    border-radius: 999px;
    background: #e6e5df;
  }

  [data-ui] .switch[hidden] {
    display: none;
  }

  [data-ui] .switch button {
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    padding: 6px 14px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #3a3a3a;
    cursor: pointer;
    transition: background .18s ease, color .18s ease;
  }

  [data-ui] .switch button[aria-pressed='true'] {
    background: #141414;
    color: #fff;
  }

  [data-ui] .switch button:focus-visible {
    outline: 2px solid var(--purple);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    [data-ui] .switch button[aria-pressed='false']:hover {
      background: #d8d7d0;
    }
  }

  [data-ui] .finding {
    max-width: 26ch;
    font-size: 16px;
    line-height: 1.4;
  }

  [data-ui] .bars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 4px;
  }

  [data-ui] .month {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  /* Each column is the full scale; its bar is scaled to the value, so a switch only moves transforms. */
  [data-ui] .col {
    position: relative;
    height: clamp(150px, 16vw, 220px);
  }

  [data-ui] .bar {
    position: absolute;
    inset: 0;
    background: #c9c8c0;
    border-radius: 4px 4px 0 0;
    transform-origin: 50% 100%;
    transform: scaleY(var(--v));
    transition: transform .7s cubic-bezier(.16, 1, .3, 1), background-color .3s ease;
  }

  [data-ui] .peak .bar {
    background: var(--purple);
  }

  /* Under each bar, in ink on the panel: legible while bars grow or switch city. */
  [data-ui] .label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    font-size: 12px;
    color: #5b5b5b;
  }

  [data-ui] .value {
    font-size: 12px;
    font-weight: 500;
    color: #141414;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  /* Values only where the columns are wide enough to hold them. */
  @media (max-width: 1099.98px) {
    [data-ui] .value {
      display: none;
    }
  }

  [data-ui] .open {
    font-size: 15px;
    font-weight: 500;
    color: inherit;
    text-underline-offset: .2em;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-ui] .bar,
    [data-ui] .switch button {
      transition: none;
    }
  }
</style>
