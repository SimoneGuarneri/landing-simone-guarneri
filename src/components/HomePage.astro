---
/**
 * The one-page home, shared by `/` (it) and `/en/`. Section order and data attributes
 * follow design/Simone Guarneri v2.dc.html; motion (#6) hooks onto the data-* attributes.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './sections/Header.astro';
import Hero from './sections/Hero.astro';
import Marquee from './sections/Marquee.astro';
import WhatIDo from './sections/WhatIDo.astro';
import Work from './sections/Work.astro';
import Building from './sections/Building.astro';
import HowIWork from './sections/HowIWork.astro';
import Skills from './sections/Skills.astro';
import Contact from './sections/Contact.astro';
import Footer from './sections/Footer.astro';
import { t, type Locale } from '../lib/i18n';
import './sections/sections.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const path = '/';
---

<BaseLayout lang={locale} path={path} title={t(locale, 'meta.title')} description={t(locale, 'meta.description')}>
  <!-- Motion mode before first paint, so effects that depend on it never shift the layout.
       Same rule as motionMode() in src/lib/motion/math.ts; the motion script keeps
       it in sync afterwards. No attribute (no JS) = static page. -->
  <script is:inline slot="head">
    (function () {
      if (!window.matchMedia) return;
      var mq = function (q) { return window.matchMedia(q).matches; };
      document.documentElement.dataset.motion = mq('(prefers-reduced-motion: reduce)')
        ? 'off'
        : mq('(max-width: 767px)') || !mq('(pointer: fine)')
          ? 'lite'
          : 'full';
    })();
  </script>
  <div class="page">
    <div data-progress class="progress" aria-hidden="true"></div>
    <Header locale={locale} />
    <main id="main" tabindex="-1">
      <Hero locale={locale} />
      <Marquee locale={locale} />
      <WhatIDo locale={locale} />
      <Work locale={locale} />
      <Building locale={locale} />
      <Skills locale={locale} />
      <HowIWork locale={locale} />
      <Contact locale={locale} />
    </main>
    <Footer locale={locale} />
  </div>
</BaseLayout>

<script>
  import '../lib/motion';
</script>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  main:focus {
    outline: none;
  }

  .progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 100%;
    transform: scaleX(0);
    transform-origin: 0 0;
    background: #7A3CF0;
    z-index: 30;
  }
</style>
