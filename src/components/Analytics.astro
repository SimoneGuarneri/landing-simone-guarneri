---
/**
 * GoatCounter page-view counter. Rendered only when `goatcounterCode` is set in
 * src/content/site.json. GoatCounter sets no cookies and stores no personal data.
 */
import { site } from '../lib/content/astro';

// Never count test runs: the e2e build (PUBLIC_E2E=1) and dev server ship no counter.
const enabled = !import.meta.env.DEV && import.meta.env.PUBLIC_E2E !== '1';
const code = enabled ? site.goatcounterCode : null;
const endpoint = code ? `https://${code}.goatcounter.com/count` : null;
---

{endpoint && <script is:inline data-goatcounter={endpoint} async src="//gc.zgo.at/count.js"></script>}
