---
import { t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
// Built from the Skills copy: property-management and computer-science items take turns,
// yellow dot for homes, purple for code. Doubled so the motion module can loop it seamlessly.
const { homes, code } = t(locale, 'skills');
const columns = [
  homes.items.map((text) => ({ text, dot: '#FFD43B' })),
  [...code.groups.flatMap((g) => g.items), code.ai.item].map((text) => ({ text, dot: '#7A3CF0' })),
];
const longest = Math.max(...columns.map((col) => col.length));
const items = Array.from({ length: longest }, (_, i) => columns.map((col) => col[i]))
  .flat()
  .filter((item) => item !== undefined);
const loop = [...items, ...items];
---

<div class="marquee-clip" aria-hidden="true">
  <div class="strip">
    <ul data-marquee class="track">
      {
        loop.map((m) => (
          <li>
            {m.text}
            <span class="dot" style={`background:${m.dot}`} />
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  /* Clips the rotated, over-wide strip horizontally (no page scroll) while the padding
     leaves room for its tilted corners. */
  .marquee-clip {
    position: relative;
    z-index: 2;
    overflow: hidden;
    padding: 40px 0;
    margin: -40px 0;
    pointer-events: none;
  }

  .strip {
    background: var(--ink);
    color: var(--bg);
    overflow: hidden;
    padding: 22px 0;
    transform: rotate(-1.5deg);
    margin: 0 -20px;
  }

  .track {
    display: flex;
    width: max-content;
    will-change: transform;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-right: 28px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(22px, 3vw, 36px);
    letter-spacing: -.02em;
    white-space: nowrap;
  }

  .dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
  }
</style>
