---
import { t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const items = t(locale, 'what');
---

<section id="what" class="what" aria-labelledby="what-title">
  <div class="sg-wrap">
    <h2 id="what-title" data-reveal="mask" class="sg-h2 title">{t(locale, 'whatTitle')}</h2>
    <ul class="grid">
      {
        items.map((w) => (
          <li data-reveal class="card">
            <div class="text">
              <h3>{w.title}</h3>
              <p>{w.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .what {
    padding: clamp(96px, 13vw, 168px) clamp(20px, 5vw, 48px) clamp(32px, 4vw, 56px);
  }

  .title {
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  /* Open columns, no boxes: the headings carry the section, space separates them. */
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 48px clamp(32px, 4vw, 64px);
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(30px, 3vw, 40px);
    line-height: 1;
    letter-spacing: -.035em;
    text-wrap: balance;
  }

  p {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    text-wrap: pretty;
  }
</style>
