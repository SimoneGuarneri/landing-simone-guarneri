---
import { t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const items = t(locale, 'how');
---

<section id="how" class="how" aria-labelledby="how-title">
  <div class="sg-wrap">
    <h2 id="how-title" data-reveal class="label">{t(locale, 'howTitle')}</h2>
    <ol class="list">
      {
        items.map((h) => (
          <li data-hl class="item">
            <h3>{h.title}</h3>
            <p>{h.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how {
    padding: clamp(72px, 9vw, 120px) clamp(20px, 5vw, 48px) clamp(48px, 6vw, 80px);
  }

  /* The design renders this title as a small mono label. */
  .label {
    margin: 0 0 40px;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 13px;
    color: var(--accent-ink);
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  /* Final (focused) state; #6 fades items by distance from the viewport centre. */
  .item {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 12px 48px;
    align-items: baseline;
    padding: clamp(24px, 3.5vw, 40px) 0;
    border-top: 1.5px solid var(--ink);
    opacity: 1;
    transition: opacity .2s linear;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(36px, 6vw, 80px);
    line-height: .95;
    letter-spacing: -.04em;
  }

  p {
    margin: 0;
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.55;
    color: var(--body);
    max-width: 36ch;
  }
</style>
