---
/**
 * Contact shell: title, body, Email and WhatsApp buttons on the left, then (when images.json
 * sets `contact`) the photo shown through a screen of fading dots; the contact form on the right.
 * The purple band continues into the site footer (Footer.astro), as in the design.
 */
import { Image } from 'astro:assets';
import ContactForm from '../ContactForm.astro';
import { contacts, imageFor } from '../../lib/content/astro';
import { t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const mailto = `mailto:${contacts.email}`;
const waLink = `https://wa.me/${contacts.whatsapp.replace(/\D/g, '')}`;
const photo = imageFor('contact', locale);
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="sg-wrap grid">
    <div class="intro">
      <h2 id="contact-title" data-reveal>{t(locale, 'contactTitle')}</h2>
      <p data-reveal>{t(locale, 'contactBody')}</p>
      <div data-reveal class="buttons">
        <a href={mailto} class="sg-btn btn-email"
          ><span aria-hidden="true">✉</span> <span class="email">{contacts.email}</span></a
        >
        <a href={waLink} target="_blank" rel="noopener" class="sg-btn btn-wa"
          >{t(locale, 'contactWhatsapp')} <span aria-hidden="true">→</span></a
        >
      </div>
      {
        photo.src && (
          <figure class="photo" data-dots>
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={[360, 720]}
              sizes="(min-width: 768px) 360px, calc(100vw - 40px)"
              class="photo-img"
            />
          </figure>
        )
      }
    </div>
    <div data-reveal class="form-col">
      <ContactForm locale={locale} />
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--purple);
    color: var(--white);
    border-radius: clamp(28px, 4vw, 48px) clamp(28px, 4vw, 48px) 0 0;
    padding: clamp(80px, 11vw, 140px) clamp(20px, 5vw, 48px) 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: 56px 80px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 28px;
    min-width: 0;
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(56px, 9vw, 128px);
    line-height: .88;
    letter-spacing: -.05em;
  }

  .intro p {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    max-width: 38ch;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .buttons .sg-btn {
    padding: 14px 22px;
    min-width: 0;
    color: var(--black);
  }

  .buttons .sg-btn:focus-visible {
    outline-color: var(--yellow);
  }

  .email {
    overflow-wrap: anywhere;
  }

  .btn-email {
    background: var(--white);
  }

  .btn-email:hover {
    transform: translateY(-3px) rotate(-2deg);
    color: var(--black);
  }

  .btn-wa {
    background: var(--yellow);
  }

  .btn-wa:hover {
    transform: translateY(-3px) rotate(2deg);
    color: var(--black);
  }

  .form-col {
    align-self: end;
    min-width: 0;
  }

  /* The photo seen through a screen of dots: black and white, lightened into the purple
     (screen blend), each dot a window on the picture, the whole fading out at the edges.
     src/lib/motion/dots.ts grows the dots in (data-dots) the first time it scrolls into
     view; without it the finished dots show. */
  @property --dot {
    syntax: '<length>';
    inherits: false;
    initial-value: 2.6px;
  }

  .photo {
    margin: auto 0 0;
    width: min(100%, 360px);
    aspect-ratio: 4 / 5;
  }

  .photo-img {
    --dot: 2.6px;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 35%;
    filter: grayscale(1) contrast(1.3) brightness(1.05);
    mix-blend-mode: screen;
    mask-image:
      radial-gradient(circle, #000 var(--dot), transparent calc(var(--dot) + .6px)),
      radial-gradient(ellipse closest-side, #000 50%, transparent 100%);
    mask-size: 6px 6px, 100% 100%;
    mask-composite: intersect;
  }

  .photo[data-dots='pending'] .photo-img {
    --dot: 0px;
  }

  .photo[data-dots='done'] .photo-img {
    animation: dots-in 1.4s cubic-bezier(.2, .8, .2, 1) both;
  }

  @keyframes dots-in {
    from {
      --dot: 0px;
    }
    to {
      --dot: 2.6px;
    }
  }
</style>
