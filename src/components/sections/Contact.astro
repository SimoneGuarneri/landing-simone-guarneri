---
/**
 * Contact shell: title, body, Email and WhatsApp buttons on the left, then (when images.json
 * sets `contact`) the photo shown through a screen of fading dots; the contact form on the right.
 * The purple band continues into the site footer (Footer.astro), as in the design.
 */
import { Image } from 'astro:assets';
import ContactForm from '../ContactForm.astro';
import { contacts, imageFor } from '../../lib/content/astro';
import { t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const mailto = `mailto:${contacts.email}`;
const waLink = `https://wa.me/${contacts.whatsapp.replace(/\D/g, '')}`;
const photo = imageFor('contact', locale);
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="sg-wrap grid">
    <div class="intro">
      <h2 id="contact-title" data-reveal>{t(locale, 'contactTitle')}</h2>
      <p data-reveal>{t(locale, 'contactBody')}</p>
      <div data-reveal class="buttons">
        <a href={mailto} class="sg-btn btn-email"
          ><span aria-hidden="true">✉</span> <span class="email">{contacts.email}</span></a
        >
        <a href={waLink} target="_blank" rel="noopener" class="sg-btn btn-wa"
          ><svg class="icon" viewBox="100 100 312 312" aria-hidden="true"
            ><path fill="none" stroke="currentColor" stroke-width="26" d="M123 393l14-65a138 138 0 1150 47z"></path><path
              fill="currentColor"
              d="M308 273c-3-2-6-3-9 1l-12 16c-3 2-5 3-9 1-15-8-36-17-54-47-1-4 1-6 3-8l9-14c2-2 1-4 0-6l-12-29c-3-8-6-7-9-7h-8c-2 0-6 1-10 5-22 22-13 53 3 73 3 4 23 40 66 59 32 14 39 12 48 10 11-1 22-10 27-19 1-3 6-16 2-18"
            ></path></svg
          >
          {t(locale, 'contactWhatsapp')}</a
        >
      </div>
      <div data-reveal class="buttons">
        <a href={contacts.linkedinUrl} target="_blank" rel="noopener" class="sg-btn btn-social"
          ><svg class="icon" viewBox="0 0 382 382" aria-hidden="true"
            ><path
              fill="currentColor"
              d="M347.445 0H34.555C15.471 0 0 15.471 0 34.555v312.889C0 366.529 15.471 382 34.555 382h312.889C366.529 382 382 366.529 382 347.444V34.555C382 15.471 366.529 0 347.445 0zM118.207 329.844c0 5.554-4.502 10.056-10.056 10.056H65.345c-5.554 0-10.056-4.502-10.056-10.056V150.403c0-5.554 4.502-10.056 10.056-10.056h42.806c5.554 0 10.056 4.502 10.056 10.056v179.441zM86.748 123.432c-22.459 0-40.666-18.207-40.666-40.666S64.289 42.1 86.748 42.1s40.666 18.207 40.666 40.666-18.206 40.666-40.666 40.666zM341.91 330.654c0 5.106-4.14 9.246-9.246 9.246H286.73c-5.106 0-9.246-4.14-9.246-9.246v-84.168c0-12.556 3.683-55.021-32.813-55.021-28.309 0-34.051 29.066-35.204 42.11v97.079c0 5.106-4.139 9.246-9.246 9.246h-44.426c-5.106 0-9.246-4.14-9.246-9.246V149.593c0-5.106 4.14-9.246 9.246-9.246h44.426c5.106 0 9.246 4.14 9.246 9.246v15.655c10.497-15.753 26.097-27.912 59.312-27.912 73.552 0 73.131 68.716 73.131 106.472v86.846z"
            ></path></svg
          >
          LinkedIn</a
        >
        <a href={contacts.githubUrl} target="_blank" rel="noopener" class="sg-btn btn-social"
          ><svg class="icon" viewBox="8 8 54 54" aria-hidden="true"
            ><path
              fill="currentColor"
              d="M58.307 21.428c-2.411-4.131-5.682-7.401-9.812-9.812C44.364 9.205 39.854 8 34.961 8c-4.891 0-9.403 1.205-13.533 3.616-4.131 2.411-7.401 5.681-9.812 9.812C9.205 25.559 8 30.07 8 34.961c0 5.875 1.714 11.158 5.143 15.85 3.429 4.693 7.858 7.94 13.287 9.742.632.117 1.1.035 1.405-.246.304-.28.456-.632.456-1.053 0-.07-.006-.702-.018-1.896-.012-1.194-.018-2.235-.018-3.124l-.807.14c-.515.094-1.164.134-1.948.123-.784-.011-1.598-.093-2.44-.246-.843-.151-1.627-.502-2.352-1.052-.725-.55-1.24-1.27-1.544-2.159l-.351-.808c-.234-.538-.603-1.135-1.106-1.79-.503-.656-1.012-1.1-1.527-1.334l-.246-.176c-.164-.117-.316-.258-.456-.422-.14-.163-.246-.327-.316-.491-.07-.164-.012-.299.176-.405.187-.105.526-.157 1.018-.157l.702.105c.468.094 1.047.374 1.738.843.69.468 1.257 1.076 1.702 1.825.539.96 1.188 1.691 1.949 2.194.76.503 1.527.755 2.299.755.772 0 1.439-.059 2.001-.175.561-.117 1.088-.293 1.58-.527.21-1.569.784-2.774 1.72-3.616-1.334-.14-2.533-.352-3.598-.632-1.065-.281-2.165-.737-3.3-1.37-1.135-.632-2.077-1.416-2.826-2.352-.749-.936-1.364-2.165-1.843-3.686-.48-1.522-.72-3.277-.72-5.266 0-2.832.925-5.243 2.774-7.232-.866-2.13-.784-4.517.246-7.161.679-.211 1.685-.053 3.019.474 1.334.526 2.311.977 2.932 1.352.62.374 1.117.69 1.492.947 2.177-.608 4.423-.912 6.74-.912s4.564.304 6.741.912l1.334-.842c.912-.562 1.99-1.077 3.229-1.545 1.241-.468 2.189-.597 2.845-.386 1.053 2.645 1.147 5.032.28 7.161 1.849 1.99 2.774 4.4 2.774 7.232 0 1.99-.241 3.75-.72 5.283-.479 1.534-1.099 2.762-1.86 3.687-.761.924-1.709 1.703-2.844 2.334-1.135.632-2.236 1.088-3.3 1.369-1.065.281-2.265.493-3.599.633 1.217 1.053 1.825 2.714 1.825 4.985v7.406c0 .421.146.772.439 1.053.293.28.755.363 1.387.245 5.43-1.801 9.859-5.049 13.288-9.741 3.428-4.693 5.143-9.975 5.143-15.85-.002-4.89-1.208-9.401-3.617-13.532z"
            ></path></svg
          >
          GitHub</a
        >
      </div>
      {
        photo.src && (
          <figure class="photo" data-dots>
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={[360, 720]}
              sizes="(min-width: 768px) 360px, calc(100vw - 40px)"
              class="photo-img"
            />
          </figure>
        )
      }
    </div>
    <div data-reveal class="form-col">
      <ContactForm locale={locale} />
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--purple);
    color: var(--white);
    border-radius: clamp(28px, 4vw, 48px) clamp(28px, 4vw, 48px) 0 0;
    padding: clamp(80px, 11vw, 140px) clamp(20px, 5vw, 48px) 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: 56px 80px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 28px;
    min-width: 0;
  }

  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(56px, 9vw, 128px);
    line-height: .88;
    letter-spacing: -.05em;
  }

  .intro p {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    max-width: 38ch;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .buttons .sg-btn {
    padding: 14px 22px;
    min-width: 0;
    color: var(--black);
  }

  .buttons .sg-btn:focus-visible {
    outline-color: var(--yellow);
  }

  .icon {
    width: 1.15em;
    height: 1.15em;
    flex: none;
  }

  .email {
    overflow-wrap: anywhere;
  }

  .btn-email {
    background: var(--white);
  }

  .btn-email:hover {
    transform: translateY(-3px) rotate(-2deg);
    color: var(--black);
  }

  .btn-wa {
    background: var(--yellow);
  }

  .btn-wa:hover {
    transform: translateY(-3px) rotate(2deg);
    color: var(--black);
  }

  /* Secondary row: outlined so Email/WhatsApp stay the main calls. */
  .buttons .btn-social {
    background: transparent;
    color: var(--white);
    box-shadow: inset 0 0 0 1.5px var(--white);
  }

  .btn-social:hover {
    background: var(--white);
    color: var(--black);
    transform: translateY(-3px);
  }

  .form-col {
    align-self: end;
    min-width: 0;
  }

  /* The photo seen through a screen of dots: black and white, lightened into the purple
     (screen blend), each dot a window on the picture, the whole fading out at the edges.
     src/lib/motion/dots.ts grows the dots in (data-dots) the first time it scrolls into
     view; without it the finished dots show. */
  @property --dot {
    syntax: '<length>';
    inherits: false;
    initial-value: 2.6px;
  }

  .photo {
    margin: auto 0 0;
    width: min(100%, 360px);
    aspect-ratio: 4 / 5;
  }

  .photo-img {
    --dot: 2.6px;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 35%;
    filter: grayscale(1) contrast(1.3) brightness(1.05);
    mix-blend-mode: screen;
    mask-image:
      radial-gradient(circle, #000 var(--dot), transparent calc(var(--dot) + .6px)),
      radial-gradient(ellipse closest-side, #000 50%, transparent 100%);
    mask-size: 6px 6px, 100% 100%;
    mask-composite: intersect;
  }

  .photo[data-dots='pending'] .photo-img {
    --dot: 0px;
  }

  .photo[data-dots='done'] .photo-img {
    animation: dots-in 1.4s cubic-bezier(.2, .8, .2, 1) both;
  }

  @keyframes dots-in {
    from {
      --dot: 0px;
    }
    to {
      --dot: 2.6px;
    }
  }
</style>
