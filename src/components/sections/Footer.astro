---
/**
 * Site footer: continues the purple contact band. © year, P.IVA and privacy link on one line
 * (spaced, no separators), then the place.
 * The year is the build year (no-JS fallback); the script refreshes it in the browser.
 */
import { contacts } from '../../lib/content/astro';
import { localizedPath, t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="sg-wrap inner">
    <div class="legal">
      <p>© <span data-year>{year}</span> Simone Guarneri</p>
      <p>{`${t(locale, 'footer.vat')} ${contacts.piva}`}</p>
      <p><a href={localizedPath(locale, '/privacy/')}>{t(locale, 'footer.privacy')}</a></p>
    </div>
    <p>{t(locale, 'footer.place')}</p>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLElement>('[data-year]').forEach((el) => {
    el.textContent = String(new Date().getFullYear());
  });
</script>

<style>
  .site-footer {
    background: var(--purple);
    color: var(--white);
    padding: clamp(72px, 10vw, 120px) clamp(20px, 5vw, 48px) 40px;
  }

  .inner {
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, .3);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    font-size: 13px;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 20px;
  }

  /* Phones: name, P.IVA and Privacy in one column, left-aligned. */
  @media (max-width: 599.98px) {
    .inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .legal {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }

  p {
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration-color: currentColor;
  }

  a:hover {
    color: var(--yellow);
  }

  a:focus-visible {
    outline: 2px solid var(--yellow);
    outline-offset: 2px;
    border-radius: 2px;
  }

  @media (pointer: coarse) {
    a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      min-width: 44px;
    }
  }
</style>
