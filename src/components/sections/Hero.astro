---
import { Image } from 'astro:assets';
import { ageOn } from '../../lib/age';
import { contacts, imageFor, Monogram } from '../../lib/content/astro';
import { t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const portrait = imageFor('portrait', locale);
const first = [...'Simone'];
const last = [...'Guarneri'];

// heroMeta carries an `{age}` placeholder: the build renders today's age (no-JS fallback),
// and the script below recomputes it in the browser, exact by day.
const [metaBefore, ...metaRest] = t(locale, 'heroMeta').split('{age}');
const metaAfter = metaRest.join('{age}');
const hasAge = metaRest.length > 0;
const age = ageOn(contacts.birthDate);
---

<section id="top" class="hero" data-hero>
  <canvas data-waves class="waves" aria-hidden="true"></canvas>
  <div data-blob class="blob" aria-hidden="true"></div>
  <div class="hero-inner">
    <p data-reveal class="eyebrow">
      <span class="eyebrow-dot" aria-hidden="true"></span>{t(locale, 'eyebrow')}
    </p>
    <h1 data-parallax class="name">
      <span class="visually-hidden">Simone Guarneri.</span>
      <span class="line line-1">
        <span aria-hidden="true">{first.map((ch) => <span data-letter>{ch}</span>)}</span><span
          data-letter
          class="portrait"
        >
          {
            portrait.src ? (
              <Image
                src={portrait.src}
                alt={portrait.alt}
                widths={[160, 320]}
                sizes="(min-width: 1480px) 142px, 10vw"
                class="portrait-img"
              />
            ) : (
              <Monogram class="portrait-img" role="img" aria-label={portrait.alt} />
            )
          }
        </span>
      </span>
      <span class="line line-2" aria-hidden="true">
        {last.map((ch) => <span data-letter>{ch}</span>)}<span data-letter class="name-dot">.</span>
      </span>
    </h1>
    <div data-reveal class="hero-copy">
      <p class="lede">
        {t(locale, 'heroA')} <span data-swipe class="swipe">{t(locale, 'heroB')}</span>
      </p>
      <div class="hero-side">
        <p class="meta">
          {metaBefore}{hasAge && <span data-age data-birth={contacts.birthDate}>{age}</span>}{metaAfter}
        </p>
        <div class="ctas">
          <a href="#contact" class="sg-btn btn-primary">{t(locale, 'cta')} <span aria-hidden="true">→</span></a>
          <a href={contacts.doroteaUrl} target="_blank" rel="noopener" class="sg-btn btn-outline"
            >Dorotea Housing <span aria-hidden="true">↗</span></a
          >
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { ageOn } from '../../lib/age';

  document.querySelectorAll<HTMLElement>('[data-age]').forEach((el) => {
    const birth = el.dataset.birth;
    if (!birth) return;
    try {
      el.textContent = String(ageOn(birth, new Date()));
    } catch {
      // Keep the build-time value.
    }
  });
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(56px, 10vw, 120px) clamp(20px, 5vw, 48px) clamp(56px, 8vw, 96px);
  }

  .waves {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    filter: blur(30px);
    opacity: var(--waves-op);
    pointer-events: none;
    transition: opacity .4s;
  }

  .blob {
    position: absolute;
    top: 0;
    left: 0;
    width: 280px;
    height: 280px;
    margin: -140px 0 0 -140px;
    border-radius: 50%;
    background: #FFD43B;
    mix-blend-mode: var(--blend);
    pointer-events: none;
    opacity: 0;
    transition: opacity .4s;
  }

  .hero-inner {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
  }

  .eyebrow {
    margin: 0 0 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--muted);
  }

  .eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #7A3CF0;
  }

  .name {
    position: relative;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    /* Design: clamp(64px, 15.5vw, 228px). The floor drops to 17vw below ~376px so
       "Guarneri." fits a 320px screen instead of being clipped. */
    font-size: clamp(min(64px, 17vw), 15.5vw, 228px);
    line-height: .86;
    letter-spacing: -.045em;
  }

  .line {
    display: block;
    overflow: hidden;
  }

  .line-1 {
    padding-bottom: .04em;
  }

  .line-2 {
    padding-bottom: .06em;
  }

  [data-letter] {
    display: inline-block;
  }

  .portrait {
    width: .62em;
    height: .62em;
    margin-left: .14em;
    vertical-align: .06em;
  }

  .portrait-img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .name-dot {
    color: var(--accent-ink);
  }

  .hero-copy {
    margin-top: clamp(32px, 5vw, 56px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 32px 64px;
    align-items: end;
  }

  .lede {
    margin: 0;
    font-size: clamp(20px, 2.4vw, 28px);
    line-height: 1.4;
    font-weight: 400;
    letter-spacing: -.01em;
    max-width: 30ch;
    text-wrap: pretty;
  }

  /* Final state of the highlight swipe (#6 animates background-size from 0%). */
  .swipe {
    background-image: linear-gradient(var(--hl), var(--hl));
    background-repeat: no-repeat;
    background-position: 0 88%;
    background-size: 100% 42%;
    transition: background-size 1.1s cubic-bezier(.7, 0, .2, 1) .9s;
  }

  .hero-side {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .meta {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--muted);
    max-width: 44ch;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ctas .sg-btn {
    padding: 15px 26px;
  }

  .btn-primary {
    background: #7A3CF0;
    color: #FFFFFF;
  }

  .btn-primary:hover {
    transform: translateY(-3px) rotate(-2deg);
    background: var(--ink);
    color: var(--bg);
  }

  .btn-outline {
    font-weight: 400;
    border: 1.5px solid var(--ink);
    color: inherit;
  }

  .btn-outline:hover {
    transform: translateY(-3px) rotate(2deg);
    background: #FFD43B;
    color: #141414;
  }
</style>
