---
/**
 * "Selected work". With full motion (≥768px, fine pointer): the design's pinned horizontal
 * track (300vh section, sticky viewport; src/lib/motion/pin.ts drives its translateX).
 * Otherwise (no JS, reduced motion, touch, <768px): a plain vertical stack.
 */
import BrandCard from './BrandCard.astro';
import { t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section id="work" class="work" data-hpin aria-labelledby="work-title">
  <div class="pin">
    <div data-track class="track">
      <div class="intro">
        <h2 id="work-title" class="sg-h2">{t(locale, 'workTitle')}</h2>
        <p>{t(locale, 'workIntro')}</p>
        <span class="hint" aria-hidden="true">{t(locale, 'scroll')} →</span>
      </div>
      <BrandCard locale={locale} brand="dorotea" />
      <BrandCard locale={locale} brand="quattro" />
    </div>
  </div>
</section>

<style>
  /* Default (no JS, reduced motion, coarse pointer, <768px): a plain vertical stack.
     The pinned horizontal track exists only under html[data-motion="full"] (fine pointer,
     ≥768px, motion allowed), set before first paint in HomePage.astro. */
  .work {
    position: relative;
    padding-top: clamp(24px, 6vw, 48px);
  }

  .track {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 0 clamp(20px, 5vw, 48px);
    align-items: stretch;
  }

  .intro {
    flex: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 20px;
    margin-bottom: 20px;
  }

  .intro p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 30ch;
  }

  /* The "keep scrolling →" hint belongs to the horizontal track only. */
  .hint {
    display: none;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent-ink);
  }

  @media (min-width: 768px) {
    .intro {
      width: min(78vw, 420px);
    }

    :global(:root[data-motion='full']) .work {
      height: 300vh;
      padding-top: 0;
    }

    :global(:root[data-motion='full']) .pin {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
      display: flex;
      align-items: center;
    }

    :global(:root[data-motion='full']) .track {
      flex-direction: row;
      will-change: transform;
    }

    :global(:root[data-motion='full']) .intro {
      margin-bottom: 0;
    }

    :global(:root[data-motion='full']) .hint {
      display: inline;
    }
  }
</style>
