---
/**
 * "Where I work": title and intro, then the two brand cards. Side by side from 900px,
 * stacked below. Same head as the other sections (Building, Skills).
 */
import BrandCard from './BrandCard.astro';
import { t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section id="work" class="work" aria-labelledby="work-title">
  <div class="sg-wrap">
    <div class="head">
      <h2 id="work-title" data-reveal class="sg-h2">{t(locale, 'workTitle')}</h2>
      <p data-reveal>{t(locale, 'workIntro')}</p>
    </div>
    <div class="cards">
      <BrandCard locale={locale} brand="dorotea" />
      <BrandCard locale={locale} brand="quattro" />
    </div>
  </div>
</section>

<style>
  .work {
    padding: clamp(72px, 9vw, 120px) clamp(20px, 5vw, 48px) 0;
  }

  .head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .head p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 40ch;
  }

  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 900px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
