---
/**
 * "What I'm building": one dark field, each project a row — the name large on the left,
 * its status and description on the right. Casadata, the one with a public demo, also
 * shows a cropped fragment of its report beside its text.
 */
import CasadataFragment from '../CasadataFragment.astro';
import { t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const items = t(locale, 'build');
---

<section id="building" class="building" aria-labelledby="building-title">
  <div class="sg-wrap">
    <div class="sg-head">
      <h2 id="building-title" data-reveal="mask" class="sg-h2">{t(locale, 'buildTitle')}</h2>
      <p data-reveal>{t(locale, 'buildIntro')}</p>
    </div>
    <ul class="rows">
      {
        items.map((b) => {
          const featured = b.title === 'Casadata';
          return (
            <li class:list={['row', { featured }]}>
              <div class="name">
                <h3 data-reveal="mask">{b.title}</h3>
              </div>
              <div data-reveal class="body">
                <span class="tag">{b.tag}</span>
                <p>{b.body}</p>
              </div>
              {featured && (
                <div data-reveal="picture" class="demo">
                  <CasadataFragment locale={locale} />
                </div>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .building {
    margin-top: clamp(96px, 12vw, 160px);
    padding: clamp(80px, 10vw, 140px) clamp(20px, 5vw, 48px);
    background: var(--ink);
    color: var(--bg);
    border-radius: clamp(28px, 4vw, 48px);
  }

  .sg-head {
    margin-bottom: clamp(56px, 7vw, 96px);
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(56px, 7vw, 96px);
  }

  .row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 900px) {
    .row {
      grid-template-columns: 5fr 7fr;
      column-gap: 64px;
      align-items: start;
    }

    /* Casadata: name and text stack on the left, its report fragment fills the right. */
    .featured {
      grid-template-rows: auto 1fr;
      row-gap: 20px;
    }

    .featured .name,
    .featured .body {
      grid-column: 1;
    }

    .featured .demo {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .featured .body {
      padding-top: 0;
    }
  }

  .demo {
    margin-top: 8px;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(44px, 6vw, 88px);
    line-height: .95;
    letter-spacing: -.045em;
  }

  .body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding-top: .5em;
  }

  .tag {
    font-size: 14px;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--yellow);
    color: var(--black);
  }

  .body p {
    margin: 0;
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.55;
    max-width: 48ch;
    text-wrap: pretty;
  }
</style>
