---
import { t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const items = t(locale, 'build');
---

<section id="building" class="building" aria-labelledby="building-title">
  <div class="sg-wrap">
    <div class="sg-head">
      <h2 id="building-title" data-reveal class="sg-h2">{t(locale, 'buildTitle')}</h2>
      <p data-reveal>{t(locale, 'buildIntro')}</p>
    </div>
    <ul class="grid">
      {
        items.map((b) => (
          <li data-reveal class="card">
            <div class="tags">
              <span class="tag">{b.tag}</span>
            </div>
            <h3>{b.title}</h3>
            <p>{b.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .building {
    padding: clamp(72px, 9vw, 120px) clamp(20px, 5vw, 48px) 0;
  }

  /* More room under the head than the shared .sg-head default. */
  .sg-head {
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 16px;
  }

  .card {
    background: var(--ink);
    color: var(--bg);
    border-radius: 28px;
    padding: clamp(28px, 3.4vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-height: 260px;
    transition: transform .35s cubic-bezier(.3, 1.5, .5, 1);
  }

  .card:hover {
    transform: translateY(-6px) rotate(1deg);
  }

  .tags {
    display: flex;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--yellow);
    color: var(--black);
  }

  h3 {
    margin: auto 0 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1;
    letter-spacing: -.04em;
  }

  .card p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    opacity: .78;
    max-width: 44ch;
    text-wrap: pretty;
  }
</style>
