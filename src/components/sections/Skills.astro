---
/**
 * Skills: one yellow field in two halves, homes and code, as the intro says ("between homes
 * and code"). Each half is a word at heading size over a few lines of running text, not a
 * column per group: the homes skills read as one sentence, the code groups as labelled lines,
 * then Claude Code with one sentence on how it is used. Copy: `skills` in it.json / en.json.
 */
import { t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { homes, code } = t(locale, 'skills');
// The homes skills run as one sentence: capital on the first only.
const homesSentence = homes.items.map((s, i) => (i ? s.charAt(0).toLowerCase() + s.slice(1) : s)).join(', ');
---

<section id="skills" class="skills" aria-labelledby="skills-title">
  <div class="sg-wrap">
    <div class="sg-head">
      <h2 id="skills-title" data-reveal="mask" class="sg-h2">{t(locale, 'skillsTitle')}</h2>
      <p data-reveal>{t(locale, 'skillsIntro')}</p>
    </div>
    <div class="halves">
      <div class="half">
        <h3 data-reveal="mask">{homes.title}</h3>
        <p data-reveal class="flow">{homesSentence}.</p>
      </div>
      <div class="half">
        <h3 data-reveal="mask">{code.title}</h3>
        <dl data-reveal class="lines">
          {
            code.groups.map((g) => (
              <div class="line">
                <dt>{g.label}</dt>
                <dd>{g.items.join(', ')}</dd>
              </div>
            ))
          }
          <div class="line">
            <dt>{code.ai.label}</dt>
            <dd>
              {code.ai.item}
              <span class="note">{code.ai.note}</span>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .skills {
    margin: clamp(96px, 12vw, 160px) 0 0;
    padding: clamp(80px, 10vw, 140px) clamp(20px, 5vw, 48px);
    background: var(--yellow);
    color: var(--black);
    border-radius: clamp(28px, 4vw, 48px);
  }

  .sg-head {
    margin-bottom: clamp(56px, 7vw, 96px);
  }

  .halves {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(56px, 7vw, 96px) clamp(40px, 6vw, 96px);
  }

  @media (min-width: 900px) {
    .halves {
      grid-template-columns: 5fr 7fr;
    }
  }

  .half {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.4vw, 28px);
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(44px, 5.6vw, 80px);
    line-height: .95;
    letter-spacing: -.045em;
    color: var(--purple);
  }

  /* The homes skills as one sentence at lead size. */
  .flow {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(22px, 2.1vw, 30px);
    line-height: 1.3;
    letter-spacing: -.02em;
    max-width: 26ch;
    text-wrap: pretty;
  }

  /* Code: a small label then its items on one line, label and items sharing a baseline. */
  .lines {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* Narrow: label and items on one run of text, so the label never sits above its line. */
  .line {
    display: block;
  }

  .line dt,
  .line dd {
    display: inline;
  }

  .line dt::after {
    content: ' ';
  }

  @media (min-width: 560px) {
    .line dt,
    .line dd {
      display: block;
    }

    .line dt::after {
      content: none;
    }

    .line {
      display: grid;
      grid-template-columns: 13ch 1fr;
      gap: 20px;
      align-items: baseline;
    }
  }

  dt {
    font-size: 16px;
    font-weight: 600;
  }

  dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(20px, 1.9vw, 26px);
    line-height: 1.3;
    letter-spacing: -.02em;
  }

  .note {
    display: block;
    margin-top: 10px;
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.5;
    letter-spacing: 0;
    max-width: 40ch;
  }
</style>
