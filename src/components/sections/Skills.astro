---
/**
 * Skills: two colour fields that reuse the marquee's dots. Yellow is the homes side
 * (chips), purple is the code side (labelled rows of chips, then Claude Code with one
 * sentence on how it is used). Copy: `skills` in it.json / en.json;
 * the marquee strip reads the same lists (Marquee.astro).
 */
import { t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { homes, code } = t(locale, 'skills');
---

<section id="skills" class="skills" aria-labelledby="skills-title">
  <div class="sg-wrap">
    <div data-reveal class="head">
      <h2 id="skills-title" class="sg-h2">{t(locale, 'skillsTitle')}</h2>
      <p>{t(locale, 'skillsIntro')}</p>
    </div>
    <div class="fields">
      <div data-reveal class="field homes">
        <h3>{homes.title}</h3>
        <ul class="chips">
          {homes.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div data-reveal class="field code">
        <h3>{code.title}</h3>
        <dl class="rows">
          {
            code.groups.map((g) => (
              <div class="row">
                <dt>{g.label}</dt>
                <dd>
                  <ul class="chips">
                    {g.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
          <div class="row">
            <dt>{code.ai.label}</dt>
            <dd>
              <ul class="chips">
                <li>{code.ai.item}</li>
              </ul>
              <p class="note">{code.ai.note}</p>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .skills {
    padding: clamp(72px, 9vw, 120px) clamp(20px, 5vw, 48px) 0;
  }

  /* Title with the intro right underneath, as in "What I'm building". */
  .head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .head p {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 40ch;
  }

  .fields {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 900px) {
    .fields {
      grid-template-columns: 5fr 7fr;
    }
  }

  .field {
    border-radius: 28px;
    padding: clamp(24px, 3.2vw, 40px);
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.4vw, 28px);
  }

  .homes {
    background: var(--yellow);
    color: var(--black);
  }

  .code {
    background: var(--purple);
    color: var(--white);
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1;
    letter-spacing: -.04em;
  }

  /* Code: label on the left, chips on the right; stacked on narrow screens. */
  .rows {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
  }

  @media (min-width: 560px) {
    .row {
      grid-template-columns: 11ch 1fr;
      gap: 16px;
      align-items: baseline;
    }
  }

  dt {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
  }

  dd {
    margin: 0;
    min-width: 0;
  }

  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chips li {
    font-size: 15px;
    line-height: 1.2;
    padding: 7px 13px;
    border-radius: 999px;
    /* A darker step of the field colour: keeps text above 4.5:1 on both. */
    background: rgba(0, 0, 0, .2);
  }

  /* Homes has one group, so its chips run larger to fill the field next to the code one. */
  .homes .chips {
    gap: 10px;
  }

  .homes .chips li {
    background: rgba(0, 0, 0, .08);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(16px, 1.6vw, 20px);
    letter-spacing: -.01em;
    padding: 10px 18px;
  }

  .note {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 1.5;
    max-width: 52ch;
    text-wrap: pretty;
  }
</style>
